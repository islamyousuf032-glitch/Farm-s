class_name Art
extends RefCounted
## Texture and TileSet helpers. Art files are generated by tools/gen_art.py into res://art.

static var _tileset: TileSet = null
static var _source_id: int = -1
static var _tile_names: Array = []
static var _tile_cols: int = 6


static func texture(path: String) -> Texture2D:
	return load("res://art/%s.png" % path) as Texture2D


static func _load_tile_meta() -> void:
	if not _tile_names.is_empty():
		return
	var txt: String = FileAccess.get_file_as_string("res://art/tiles/tiles.json")
	var parsed: Variant = JSON.parse_string(txt)
	if typeof(parsed) == TYPE_DICTIONARY:
		_tile_names = (parsed as Dictionary)["names"]
		_tile_cols = int((parsed as Dictionary)["cols"])


static func tileset() -> TileSet:
	if _tileset != null:
		return _tileset
	_load_tile_meta()
	var ts: TileSet = TileSet.new()
	ts.tile_size = Vector2i(16, 16)
	var src: TileSetAtlasSource = TileSetAtlasSource.new()
	src.texture = load("res://art/tiles/tiles.png") as Texture2D
	src.texture_region_size = Vector2i(16, 16)
	for i in range(_tile_names.size()):
		src.create_tile(tile_atlas(_tile_names[i]))
	_source_id = ts.add_source(src)
	_tileset = ts
	return ts


static func tile_source() -> int:
	tileset()
	return _source_id


static func tile_atlas(name: String) -> Vector2i:
	_load_tile_meta()
	var i: int = _tile_names.find(name)
	if i < 0:
		i = 0
	return Vector2i(i % _tile_cols, i / _tile_cols)


static func item_texture(id: String) -> Texture2D:
	if GameData.is_tool(id):
		return texture("items/tool_%s" % id)
	var parts: PackedStringArray = id.split("_", true, 1)
	if parts.size() < 2:
		return texture("items/coin")
	return texture("items/%s_%s" % [parts[0], parts[1]])
