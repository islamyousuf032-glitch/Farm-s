[configuration]

entry_symbol = "chalabon_core_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

; Godot 4 keys are "debug" (editor + debug builds) and "release" (export templates).
; Both point to the release build of the C++ core so there is exactly one binary per platform.
linux.debug.x86_64 = "res://addons/chalabon_core/bin/libchalabon_core.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://addons/chalabon_core/bin/libchalabon_core.linux.template_release.x86_64.so"
android.debug.arm64 = "res://addons/chalabon_core/bin/libchalabon_core.android.template_release.arm64.so"
android.release.arm64 = "res://addons/chalabon_core/bin/libchalabon_core.android.template_release.arm64.so"
