[configuration]

entry_symbol = "chalabon_core_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

linux.template_debug.x86_64 = "res://addons/chalabon_core/bin/libchalabon_core.linux.template_debug.x86_64.so"
linux.template_release.x86_64 = "res://addons/chalabon_core/bin/libchalabon_core.linux.template_release.x86_64.so"
android.template_debug.arm64 = "res://addons/chalabon_core/bin/libchalabon_core.android.template_debug.arm64.so"
android.template_release.arm64 = "res://addons/chalabon_core/bin/libchalabon_core.android.template_release.arm64.so"
