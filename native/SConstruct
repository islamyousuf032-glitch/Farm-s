#!/usr/bin/env python
# Build script for the chalabon_core GDExtension (godot-cpp is cloned into native/godot-cpp by CI).
import os

env = SConscript("godot-cpp/SConstruct")
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

library_name = "libchalabon_core.{}.{}.{}".format(env["platform"], env["target"], env["arch"])
library = env.SharedLibrary(
    "../godot/addons/chalabon_core/bin/{}{}".format(library_name, env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
